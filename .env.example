# ==============================================================================
# Up Speaking Placement Test System - Environment Variables Template
# Salin file ini menjadi .env.local untuk pengembangan lokal,
# atau masukkan variabel berikut ke Dashboard Vercel pada menu Environment Variables.
# ==============================================================================

# Supabase Project Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Supabase Service Role Key (Privileged server-side operations)
# Diperoleh di: Supabase Dashboard > Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Student Session Token Secret (HMAC-SHA256 signing key)
# Opsional: Jika tidak diisi, otomatis menggunakan SUPABASE_SERVICE_ROLE_KEY
STUDENT_TOKEN_SECRET="your-dedicated-32-char-random-secret"

# Application Base URL
# Lokal: http://localhost:3000
# Produksi: https://your-deployment.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"
